{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schedule.schema.json",
  "title": "Vehicle maintenance schedule (Israel)",
  "description": "One file per make + model + generation + engine family. Written in our own words from importer/manufacturer books. Never paste book text verbatim.",
  "type": "object",
  "required": [
    "id",
    "make",
    "model",
    "years",
    "engines",
    "importer",
    "interval",
    "cycle_km",
    "services",
    "sources",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9.]+)*$",
      "description": "e.g. toyota-corolla-2019-2025-1.8-hybrid"
    },
    "make": {
      "type": "string"
    },
    "make_he": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "model_he": {
      "type": "string"
    },
    "generation": {
      "type": "string",
      "description": "Manufacturer code if known, e.g. E210"
    },
    "years": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[first_year, last_year] sold in Israel"
    },
    "engines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Engine families this file covers, e.g. '1.8 hybrid'"
    },
    "fuel": {
      "type": "string",
      "enum": [
        "petrol",
        "diesel",
        "hybrid",
        "plug-in-hybrid",
        "electric",
        "petrol-or-diesel"
      ],
      "description": "petrol-or-diesel: one file covers both engine types (the notes say which rows apply to which)"
    },
    "importer": {
      "type": "string",
      "description": "Israeli importer, Hebrew"
    },
    "interval": {
      "type": "object",
      "required": [
        "km",
        "months"
      ],
      "properties": {
        "km": {
          "type": "integer"
        },
        "months": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "first_service_km": {
      "type": "integer",
      "description": "Only when the first service is not at interval.km (e.g. Hyundai i10/i20 2014-2017: first at 15,000, then every 20,000). services[].km must equal first_service_km + n*interval.km."
    },
    "cycle_km": {
      "type": "integer",
      "description": "After this km the plan repeats: service at km K uses the entry at ((K - first) mod cycle_km) + first. Long-interval items are handled separately."
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "km",
          "items"
        ],
        "properties": {
          "km": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item",
                "action"
              ],
              "properties": {
                "item": {
                  "type": "string",
                  "description": "Key from data/items.json"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "replace",
                    "inspect",
                    "adjust",
                    "clean",
                    "rotate"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "long_interval": {
      "type": "array",
      "description": "Items whose interval is longer than the grid or not aligned to it (spark plugs every 150,000; coolant first at 210,000 then every 30,000). Either every_km/every_months, or first_* then then_every_*.",
      "items": {
        "type": "object",
        "required": [
          "item",
          "action"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "replace",
              "inspect",
              "adjust",
              "clean",
              "rotate"
            ]
          },
          "every_km": {
            "type": "integer"
          },
          "every_months": {
            "type": "integer"
          },
          "first_km": {
            "type": "integer"
          },
          "first_months": {
            "type": "integer"
          },
          "then_every_km": {
            "type": "integer"
          },
          "then_every_months": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "time_based": {
      "type": "array",
      "description": "Items that are due by age regardless of km",
      "items": {
        "type": "object",
        "required": [
          "item",
          "action",
          "months"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "months": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "specs": {
      "type": "object",
      "description": "Useful facts from the owner's book, one line each, Hebrew. Keys: engine_oil, oil_capacity, coolant, brake_fluid, fuel, tires, tire_pressure, battery, timing, spare, wipers, warranty, _note. _note says whether the values are a draft or were checked against the importer's book.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "kind"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "importer",
              "manufacturer",
              "garage",
              "forum",
              "other"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "verified"
      ],
      "description": "draft = collected from the web; reviewed = transcribed from the Israeli importer's book; verified = a second person checked it line by line against the book"
    },
    "notes": {
      "type": "string"
    }
  }
}
