    {
      "url": "https://procarmanuals.com/daihatsu-sirion-model-m300-series-service-manual-no-9890-maintenance/",
      "kind": "other",
      "note": "עמוד האתר שמציג את הפרק (קובץ ה-PDF מוטמע)"
