    {
      "url": "https://prodmedia.colmobil.co.il/media/sites/2/2023/06/%D7%99%D7%95%D7%93%D7%90%D7%99-%D7%98%D7%95%D7%A1%D7%95%D7%9F-%D7%A1%D7%A4%D7%A8-%D7%A8%D7%9B%D7%91.pdf",
      "kind": "importer",
      "note": "ספר רכב טוסון (NX4, הפקה 2021) של כלמוביל, עמודי PDF 475-478 (9-8 עד 9-11)"
    }
