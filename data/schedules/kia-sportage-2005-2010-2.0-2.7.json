    },
    {
      "item": "transfer_case_oil",
      "action": "replace",
      "every_km": 100000,
      "note": "4WD: בדיקה כל 40,000, החלפה כל 100,000"
    },
    {
      "item": "differential_oil",
      "action": "inspect",
      "every_km": 40000,
      "note": "4WD: שמן הסרן האחורי"
